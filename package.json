    "test:content": "node --test content/tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "pg": "8.23.1",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19",
    "socket.io-client": "4.8.4"
  }
}
