+/** CDP只录真实视口；截图不使用fullPage，也不改变录制中的视口尺寸。 */
+export async function recordViewport(page, output, name) {
+  const folder = resolve(output, name); await mkdir(resolve(folder, 'frames'), { recursive: true });
+  const session = await page.context().newCDPSession(page), frames = [], writes = [], errors = [];
+  let lastReceived = performance.now(), closed = false;
+  const startedAt = new Date().toISOString();
+  const onFrame = event => {
+    const file = `frames/${String(frames.length).padStart(6, '0')}.jpg`; lastReceived = performance.now();
+    frames.push({ file, timestamp: event.metadata.timestamp, receivedMs: lastReceived, metadata: event.metadata, width: event.metadata.deviceWidth, height: event.metadata.deviceHeight });
+    writes.push(writeFile(resolve(folder, file), Buffer.from(event.data, 'base64')).catch(error => errors.push(String(error))));
+    writes.push(session.send('Page.screencastFrameAck', { sessionId: event.sessionId }).catch(error => errors.push(String(error))));
+  };
+  session.on('Page.screencastFrame', onFrame);
+  const viewport = page.viewportSize();
+  await session.send('Page.startScreencast', { format: 'jpeg', quality: 86, maxWidth: viewport.width, maxHeight: viewport.height, everyNthFrame: 1 });
+  return { async stop() {
+    if (closed) return null; closed = true;
+    await session.send('Page.stopScreencast');
+    // stop响应之后停止接收事件，再排空全部写入/ack；不能在detach期间新增未等待的ack。
+    session.off('Page.screencastFrame', onFrame);
+    const tail = Math.max(0.04, (performance.now() - lastReceived) / 1000), pageClosedAtStop = page.isClosed();
+    await Promise.all(writes); await session.detach();
+    await saveJSON(resolve(folder, 'raw-recording.json'), { startedAt, viewport, frames, errors, pageClosedAtStop, timingSource: 'CDP原始帧抵达单调时钟；保留协议可选timestamp，不将其当作性能时钟' });
+    assert.equal(pageClosedAtStop, false, '录制停止时真实游戏页面仍存活');
+    assert.deepEqual(errors, []); assert.ok(frames.length > 1, '连续视口录制实际取得帧');
+    const lines = ['ffconcat version 1.0'];
+    for (const [index, frame] of frames.entries()) {
+      const duration = index + 1 < frames.length ? (frames[index + 1].receivedMs - frame.receivedMs) / 1000 : tail;
+      assert.ok(duration >= 0, '原始录帧抵达时钟不倒退');
+      lines.push(`file '${frame.file}'`, 'option framerate 1000', `duration ${Math.max(0.001, duration).toFixed(6)}`);
