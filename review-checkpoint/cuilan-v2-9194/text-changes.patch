diff --git a/docs/design-direction/gaolaozhuang-cuilan-v2/verify-assets.mjs b/docs/design-direction/gaolaozhuang-cuilan-v2/verify-assets.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..3bb85a91778a22cd3f9d3194b78479a4e215f06d
--- /dev/null
+++ b/docs/design-direction/gaolaozhuang-cuilan-v2/verify-assets.mjs
@@ -0,0 +1,44 @@
+import {readFile,stat} from 'node:fs/promises';
+import {resolve,dirname,sep} from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {createHash} from 'node:crypto';
+const root=dirname(fileURLToPath(import.meta.url));
+const manifest=JSON.parse(await readFile(resolve(root,'manifest.json'),'utf8'));
+const runtime=JSON.parse(await readFile(resolve(root,'runtime-manifest.json'),'utf8'));
+const errors=[],seen=new Set(),rows=[];
+const hash=b=>createHash('sha256').update(b).digest('hex');
+const native=Object.entries(manifest.directions).filter(([,v])=>!v.mirrorOf);
+for(const [d,v] of native){
+ if(v.walk.frames.length!==8)errors.push(d+'：不是8帧');
+ const frames=[...v.walk.frames,v.idle],scale=manifest.groups[d]?.scale;
+ if(!(scale>0))errors.push(d+'：组倍率无效');
+ for(let i=0;i<frames.length;i++){
+  const f=frames[i],path=resolve(root,f.file);
+  if(!path.startsWith(root+sep)){errors.push('越界路径：'+f.file);continue}
+  try{
+   const b=await readFile(path);
+   if(b.subarray(0,8).toString('hex')!=='89504e470d0a1a0a')errors.push(f.file+'：不是PNG');
+   if(b.readUInt32BE(16)!==418||b.readUInt32BE(20)!==418||b[25]!==6)errors.push(f.file+'：不是418 RGBA');
+   if(hash(b)!==f.sha256)errors.push(f.file+'：hash不符');
+   const r=i===8?runtime.native[d].idle:runtime.native[d].walk[i];
+   if(r.file!==f.file||r.sha256!==f.sha256||r.scale!==scale||r.footPivot.x!==f.footPivot[0]||r.footPivot.y!==f.footPivot[1])errors.push(f.file+'：两合同不一致');
+   if(f.footPivot.some(x=>!Number.isFinite(x)||x<0||x>418))errors.push(f.file+'：脚点越界');
+   if(!manifest.groups[d].sources.some(x=>x.file===f.file&&x.sha256===f.sha256))errors.push(f.file+'：来源未列出');
+   rows.push({file:f.file,sha256:f.sha256,bytes:b.length});seen.add(f.file);
+  }catch(e){errors.push(f.file+'：'+e.message)}
+ }
+ if(new Set(frames.map(f=>f.sha256)).size!==9)errors.push(d+'：帧重复');
+}
+for(const [d,v] of Object.entries(manifest.directions)){
+ const r=runtime.directions[d];
+ if(v.mirrorOf){
+  if(!manifest.directions[v.mirrorOf]||manifest.directions[v.mirrorOf].mirrorOf)errors.push(d+'：镜像目标无效');
+  if(r.nativeDirection!==v.mirrorOf||!r.mirrorX)errors.push(d+'：镜像运行映射不符');
+ }else if(r.nativeDirection!==d||r.mirrorX)errors.push(d+'：原生运行映射不符');
+}
+if(seen.size!==native.length*9)errors.push('文件数量不符');
+const full=native.length===5&&Object.keys(manifest.directions).length===8;
+if(process.argv.includes('--full')&&!full)errors.push('尚非5原生+3镜像完整角色');
+console.log(JSON.stringify({status:errors.length?'FAIL':'PASS',scope:'文件hash/尺寸/RGBA/脚点/固定倍率/映射；不判定艺术与步态',fullCharacter:full,native:native.map(([d])=>d),directions:Object.keys(manifest.directions),pngFiles:seen.size,pngBytes:rows.reduce((s,r)=>s+r.bytes,0),manifestSha256:hash(await readFile(resolve(root,'manifest.json'))),runtimeManifestSha256:hash(await readFile(resolve(root,'runtime-manifest.json'))),errors},null,2));
+process.exitCode=errors.length?1:0;
+
