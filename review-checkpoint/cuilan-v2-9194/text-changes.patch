index 0000000000000000000000000000000000000000..b2eda3f0f1a4111d734207140165f293fd0654e2
--- /dev/null
+++ b/docs/design-direction/gaolaozhuang-cuilan-v2/preview.html
@@ -0,0 +1,84 @@
+<!doctype html>
+<html lang="zh-CN">
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>翠兰 v2 序列帧预览</title>
+<style>
+:root{font:16px system-ui,sans-serif;color:#302e2a;background:#f1eee6}body{margin:0}main{max-width:1200px;margin:auto}
+header{display:flex;gap:14px;align-items:center;flex-wrap:wrap;padding:14px 20px;background:#faf8f2;border-bottom:1px solid #c8c2b4}
+h1{font-size:20px;margin:0 10px 0 0}select,button{font:inherit;border:1px solid #aaa28f;background:#fffdf7;border-radius:4px;padding:6px 10px;color:inherit}
+button{cursor:pointer}canvas{display:block;max-width:100%;height:auto}footer{padding:10px 20px;color:#665e50;font-size:13px}
+</style>
+<main>
+<header><h1>翠兰 v2 · 动作候选</h1>
+<label>朝向 <select id="direction"></select></label>
+<button id="motion">停步</button><button id="pause">暂停</button><button id="restart">重开</button>
+<label>底色 <select id="background"><option value="light">浅色</option><option value="green">庭院绿灰</option><option value="dark">深色</option></select></label>
+<span id="status" aria-live="polite">加载中</span></header>
+<canvas id="stage" width="1200" height="780" aria-label="连续动作预览及方向对照"></canvas>
+<footer>新创作候选，独立审查待执行。左侧 3×，右侧 1×，下方 1.5×；最终组倍率只使用一次。正式游戏接入另行验证。</footer>
+</main>
+<script type="module">
+const canvas=document.querySelector('#stage'),ctx=canvas.getContext('2d');
+const directionSelect=document.querySelector('#direction'),status=document.querySelector('#status');
+const manifest=await fetch('./manifest.json').then(r=>{if(!r.ok)throw Error('manifest加载失败');return r.json()});
+const requested=['n','ne','e','se','s','sw','w','nw'],available=requested.filter(d=>manifest.directions[d]);
+for(const d of available){const op=document.createElement('option');op.value=d;op.textContent=d.toUpperCase();directionSelect.append(op)}
+let direction=available.includes('se')?'se':available[0],moving=true,paused=false,distance=0,lastTime=null,background='light';
+directionSelect.value=direction;
+const images=new Map();
+for(const group of Object.values(manifest.groups))for(const f of group.sources){
+ if(images.has(f.file))continue;
+ const im=new Image();im.src=f.file;
+ await im.decode();images.set(f.file,im);
+}
+const reviewState={ready:true,loadedFiles:images.size,samples:[],events:[],cycleDistance:147.6,previewSpeed:205,phaseSource:'模拟累计路程；停止和暂停均不推进'};
+window.reviewState=reviewState;
+function log(type){reviewState.events.push({type,direction,moving,paused,distance,time:performance.now()})}
+directionSelect.addEventListener('change',()=>{direction=directionSelect.value;log('turn')});
+document.querySelector('#motion').addEventListener('click',()=>{moving=!moving;document.querySelector('#motion').textContent=moving?'停步':'行走';log(moving?'walk':'idle')});
+document.querySelector('#pause').addEventListener('click',()=>{paused=!paused;document.querySelector('#pause').textContent=paused?'继续':'暂停';log(paused?'pause':'resume')});
+document.querySelector('#restart').addEventListener('click',()=>{distance=0;log('restart')});
+document.querySelector('#background').addEventListener('change',e=>{background=e.target.value;log('background')});
+function resolve(d,index,idle=false){
+ const entry=manifest.directions[d],mirror='mirrorOf' in entry,native=mirror?entry.mirrorOf:d;
+ const item=manifest.directions[native],frame=idle?item.idle:item.walk.frames[index%item.walk.frames.length];
+ return {frame,mirror,scale:manifest.groups[frame.group].scale,native};
+}
+function sprite(d,index,x,y,magnification=1,idle=false){
+ const {frame,mirror,scale}=resolve(d,index,idle);ctx.save();ctx.translate(x,y);
+ ctx.scale((mirror?-1:1)*scale*magnification,scale*magnification);
+ ctx.drawImage(images.get(frame.file),-frame.footPivot[0],-frame.footPivot[1]);ctx.restore();
+}
+function text(s,x,y,size=15,color='#514b40'){ctx.fillStyle=color;ctx.font=size+'px system-ui,sans-serif';ctx.fillText(s,x,y)}
+let previousKey='';
+function render(now){
+ const dt=lastTime===null?0:Math.min(now-lastTime,100);lastTime=now;
+ if(moving&&!paused)distance+=205*dt/1000;
+ const index=Math.floor(distance/147.6*8)%8;
+ const bg={light:'#e9e2d3',green:'#b9c3aa',dark:'#303b3b'}[background],ink=background==='dark'?'#eee9dd':'#514b40';
+ ctx.fillStyle=bg;ctx.fillRect(0,0,1200,780);
+ text('选中方向  '+direction.toUpperCase()+'   '+(moving?'行走':'独立站姿'),42,42,20,ink);
+ text('3× 动作细看',42,70,14,ink);
+ ctx.strokeStyle=background==='dark'?'#87968b':'#b9af9c';ctx.lineWidth=1;
+ ctx.beginPath();ctx.moveTo(58,365);ctx.lineTo(440,365);ctx.stroke();
+ sprite(direction,index,244,365,3,!moving);
+ text('脚点固定于基线；相位按累计路程推进',58,405,14,ink);
+ text('8 向最终显示尺寸 · 1×',520,42,20,ink);
+ available.forEach((d,i)=>{const x=578+(i%4)*161,y=180+Math.floor(i/4)*175;
+  sprite(d,index,x,y,1,!moving);text(d.toUpperCase()+(manifest.directions[d].mirrorOf?' 镜像':''),x-25,y+28,13,ink);
+ });
+ text('单循环 00 → 07 → 00 / 站姿独立 · 1.5×',42,500,18,ink);
+ for(let i=0;i<9;i++){const x=70+i*132;sprite(direction,i, x,690,1.5,i===8);text(i===8?'idle':String(i).padStart(2,'0'),x-15,723,14,ink);
+  if(moving&&i===index){ctx.strokeStyle=ink;ctx.strokeRect(x-52,549,104,181)}
+ }
+ Object.assign(reviewState,{direction,moving,paused,distance,frameIndex:moving?index:null,background,time:now});
+ const key=[direction,moving,paused,index].join('/');
+ if(key!==previousKey){reviewState.samples.push({direction,moving,paused,distance,index:moving?index:null,time:now});previousKey=key}
+ status.textContent=(paused?'已暂停 · ':'')+(moving?'第 '+index+' 帧':'站立')+' · 已读 '+images.size+' 帧';
+ requestAnimationFrame(render);
+}
+log('ready');requestAnimationFrame(render);
+</script>
+</html>
+
