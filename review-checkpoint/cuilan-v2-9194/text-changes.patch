+    const result = { name, startedAt, finishedAt: new Date().toISOString(), viewport, timingSource: 'CDP原始帧抵达单调时钟，非产品FPS/性能测量', frameCount: frames.length, sha256: sha256(await readFile(video)), video, probe, frames };
+    await saveJSON(resolve(folder, 'recording.json'), result); return result;
+  } };
