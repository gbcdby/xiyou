+  assert.equal(expanded.panel.class.includes('hud-card-collapsed'), false, '明确恢复后对象列表真正展开');
+  assert.deepEqual(expanded.actions, selected.actions); assert.deepEqual(expanded.queuedAction, selected.queuedAction);
+  await capture(page, 'door-restored-objects');
+  await page.locator('.spatial-object-list').getByRole('button', { name: '铜封门', exact: true }).click();
+  const reselected = await read(page); assert.equal(reselected.selected, target.entityRef); checkGeometry(reselected);
