+  const entry = { name, targetRef: person.entityRef, point, before, selected }; report.cases.push(entry);
+  await capture(page, name + '-selected');
+  const restore = page.getByRole('button', { name: '取消选择并展开', exact: true });
+  if (await restore.isVisible()) {
+    await restore.click(); entry.restored = await read(page); await capture(page, name + '-restored');
+    assert.equal(entry.restored.selected, ''); assert.deepEqual(entry.restored.actions, selected.actions); assert.deepEqual(entry.restored.queuedAction, selected.queuedAction); checkGeometry(entry.restored);
+    if (!entry.restored.panel?.visible || entry.restored.panel.kind !== 'objects') report.issues.push({ name, reason: '明确恢复后对象区未展开', before: selected.panel, after: entry.restored.panel });
+    // 原红诊断继续使用既有公开入口核同人重选；记录失败，绝不借此把整轮标绿。
+    if (!entry.restored.panel) await page.getByRole('button', { name: '附近对象与出口', exact: true }).click();
+    await page.locator('.spatial-object-list').getByRole('button', { name: selected.panel.heading.trim(), exact: true }).click();
+    entry.reselected = await read(page); await capture(page, name + '-reselected'); checkGeometry(entry.reselected);
+  }
+  const inspect = page.getByRole('button', { name: '走近并查看', exact: true });
+  if (!(await inspect.isVisible())) { report.issues.push({ name, reason: '同一授权目标的走近查看动作不可达' }); return; }
+  const ids = new Set((await clientState(page)).actions.map(action => action.id));
+  await inspect.click();
+  const request = await until(async () => (await clientState(page)).actions.find(action => !ids.has(action.id) && JSON.parse(action.raw).action.kind === 'inspect' && action.receipt), '真实查看请求和收据');
+  assert.equal(JSON.parse(request.raw).action.targetRef, person.entityRef); assert.equal(request.receipt.status, 'Accepted');
+  await until(async () => BigInt((await snapshot(page)).snapshotSeq) >= BigInt(request.receipt.observedSeq), '查看收据已进入本端公开投影');
+  entry.inspect = request; entry.after = await read(page); checkGeometry(entry.after); await capture(page, name + '-inspected');
+  report.checks.push({ name, status: 'PASS', targetRef: person.entityRef, receipt: request.receipt });
+}
+
+async function recoverWithNavigation(page) {
+  await closeObjectPanel(page); await room.go(0, room.C('C18'));
