+  assert.equal(move.receipt.status, 'Accepted'); assert.equal(JSON.parse(move.raw).action.targetRef, target.entityRef);
+  const pending = await read(page); assert.ok(pending.queuedAction, '恢复前必须存在实际待执行的查看意图');
+  assert.equal(pending.selected, target.entityRef); await restore.click(); const restoredMoving = await read(page);
