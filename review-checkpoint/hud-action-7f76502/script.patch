+    const s = spatialState.value, p = s.snapshot.projection;
+    const map = document.querySelector('svg.spatial-map'), props = map.__vueParentComponent.props;
+    const rect = node => { const b = node.getBoundingClientRect(); return { x: b.x, y: b.y, width: b.width, height: b.height }; };
+    const visible = node => { const b = rect(node), css = getComputedStyle(node); return b.width > 0 && b.height > 0 && css.visibility !== 'hidden' && css.display !== 'none'; };
+    const refs = new Set([p.self.entityRef, props.selected, ...(p.chapter?.follows || []).filter(f => ['accepted', 'following', 'paused', 'arrived'].includes(f.status)).map(f => f.subjectRef)]);
+    const people = [p.self, ...p.entities], names = new Set(people.filter(person => refs.has(person.entityRef)).map(person => (props.personLabels?.[person.entityRef] || person.name) + (person.entityRef === p.self.entityRef ? ' · 你' : '')));
+    const regions = [];
+    for (const node of document.querySelectorAll('.spatial-person')) {
+      const person = people.find(person => node.__vnode?.key === person.entityRef + ':' + person.appearanceEpoch);
+      const shape = node.querySelector('image,.spatial-actor-fallback');
+      if (shape && person && refs.has(person.entityRef)) regions.push({ name: node.getAttribute('aria-label'), kind: 'body', ...rect(shape) });
+    }
+    for (const node of document.querySelectorAll('.spatial-target.selected,.spatial-item.selected')) { const shape = node.querySelector('rect,path'); if (shape) regions.push({ name: node.getAttribute('aria-label'), kind: 'target', ...rect(shape) }); }
+    for (const node of document.querySelectorAll('.spatial-map-label')) if (node.classList.contains('self') || node.classList.contains('selected') || names.has(node.getAttribute('title'))) regions.push({ name: node.getAttribute('title'), kind: 'name', ...rect(node) });
+    const cards = [...document.querySelectorAll('.spatial-sidebar,.spatial-follow-strip,.spatial-receipts')].filter(visible).map(node => ({ kind: node.className, ...rect(node) }));
+    const gap = (a, b) => Math.max(a.x - b.x - b.width, b.x - a.x - a.width, a.y - b.y - b.height, b.y - a.y - a.height);
+    const violations = cards.flatMap(card => regions.filter(region => gap(card, region) < 15.9).map(region => ({ card, region, gap: gap(card, region) })));
+    const background = rect(document.querySelector('.spatial-scene-art')), viewport = rect(map), panel = document.querySelector('.spatial-sidebar');
+    const covered = background.x <= viewport.x + .1 && background.y <= viewport.y + .1 && background.x + background.width >= viewport.x + viewport.width - .1 && background.y + background.height >= viewport.y + viewport.height - .1;
+    const missingNames = [...names].filter(name => !regions.some(region => region.kind === 'name' && region.name === name));
+    const condensedControls = [...document.querySelectorAll('.gaolao-condensed button')].filter(visible).map(node => ({ label: node.textContent.trim() || node.getAttribute('aria-label'), font: parseFloat(getComputedStyle(node).fontSize), ...rect(node) }));
+    return { snapshotSeq: s.snapshot.snapshotSeq, viewId: s.snapshot.viewId, self: p.self.position, movement: p.movement, queuedAction: s.queuedAction, selected: props.selected, actions: s.actions.map(({ id, raw, receipt }) => ({ id, raw, receipt })), panel: panel ? { kind: panel.getAttribute('data-reading-kind'), class: panel.className, visible: visible(panel), heading: document.getElementById('spatial-selection-heading')?.textContent } : null, geometry: { viewport, background, covered, regions, cards, violations, missingNames, condensedControls }, cameraArea: props.cameraArea, viewBox: map.getAttribute('viewBox') };
+    };
+    return window.__hudActionRead();
+  });
+}
+function checkGeometry(value) { assert.equal(value.geometry.covered, true, '实际背景覆盖地图'); assert.deepEqual(value.geometry.missingNames, [], '必要姓名不得被省略'); assert.deepEqual(value.geometry.violations, [], '实际当前身体/物件/最终名字和浮卡保留16px'); assert.ok(value.geometry.condensedControls.every(control => control.width >= 44 && control.height >= 44 && control.font >= 14), '短卡真实控件保留44px和14px'); }
+async function startGeometry(page) {
+  await read(page);
+  await page.evaluate(() => {
+    const data = window.__hudActionMotion = { running: true, frames: [], errors: [] };
+    const sample = now => {
+      if (!data.running) return;
+      try { const value = window.__hudActionRead(); data.frames.push({ now, selected: value.selected, snapshotSeq: value.snapshotSeq, movement: value.movement?.status, geometry: value.geometry, viewBox: value.viewBox }); }
+      catch (error) { data.errors.push(error.stack || String(error)); }
+      requestAnimationFrame(now => queueMicrotask(() => sample(now)));
+    };
+    requestAnimationFrame(now => queueMicrotask(() => sample(now)));
+  });
+}
+async function finishGeometry(page) {
+  report.motion = await page.evaluate(() => { window.__hudActionMotion.running = false; return window.__hudActionMotion; });
+  assert.ok(report.motion.frames.length >= 5, '恢复与实际接近必须有连续绘制帧');
+  assert.deepEqual(report.motion.errors, []);
+  for (const frame of report.motion.frames) checkGeometry(frame);
+}
+async function closeObjectPanel(page) {
+  const condensed = page.getByRole('button', { name: '关闭暂收浮卡', exact: true });
+  const expanded = page.getByRole('button', { name: '关闭对象区', exact: true });
+  if (await condensed.isVisible()) await condensed.click(); else if (await expanded.isVisible()) await expanded.click();
+}
+async function inspectCase(page, name, person) {
