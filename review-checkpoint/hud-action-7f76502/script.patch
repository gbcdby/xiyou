+  assert.ok(selected.panel?.class.includes('hud-card-collapsed'), '合法远处铜封门保留原短卡状态');
+  assert.equal(selected.selected, target.entityRef); checkGeometry(selected); await capture(page, 'door-selected-short');
+  await restore.click(); const expanded = await read(page); checkGeometry(expanded);
