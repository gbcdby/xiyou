+  if (room) { const videos = room.pages.map(page => page.video()); await room.close(); for (let i = 0; i < videos.length; i++) if (videos[i]) { const file = 'actual-ui-' + (i + 1) + '.webm'; await videos[i].saveAs(resolve(output, file)); report.videos.push({ file, sha256: sha256(await readFile(resolve(output, file))) }); } }
