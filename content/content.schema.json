{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gbcdby/xiyou/content/schema-v1",
  "title": "xiyou 首个机制场景内容结构",
  "description": "仅定义配置结构；运行时权限、提交、感知和结局必须由权威服务执行。",
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
    },
    "Scalar": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "FactField": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/Id"
        },
        "label": {
          "type": "string",
          "maxLength": 120
        },
        "value": {
          "$ref": "#/$defs/Scalar"
        }
      },
      "required": [
        "key",
        "label",
        "value"
      ],
      "additionalProperties": false
    },
    "Location": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "region"
            },
            "regionId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "regionId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "role"
            },
            "roleId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "roleId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Role": {
      "type": "object",
      "properties": {
        "roleId": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "motivation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "initialKnowledgeIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "initialRegionId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "roleId",
        "name",
        "motivation",
        "capabilities",
        "initialKnowledgeIds",
        "initialRegionId"
      ],
      "additionalProperties": false
    },
    "Region": {
      "type": "object",
      "properties": {
        "regionId": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "enum": [
            "scene",
            "exit"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "exits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        },
        "entryRequirement": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "targetId": {
                  "$ref": "#/$defs/Id"
                },
                "fields": {
                  "type": "object",
                  "propertyNames": {
                    "$ref": "#/$defs/Id"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/Scalar"
                  },
                  "maxProperties": 32
                }
              },
              "required": [
                "targetId",
                "fields"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "regionId",
        "kind",
        "name",
        "description",
        "exits",
        "entryRequirement"
      ],
      "additionalProperties": false
    },
    "Target": {
      "type": "object",
      "properties": {
        "targetId": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "regionId": {
          "$ref": "#/$defs/Id"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FactField"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "inspections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requiredCapability": {
                "$ref": "#/$defs/Id"
              },
              "knowledgeIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Id"
                },
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true
              }
            },
            "required": [
              "requiredCapability",
              "knowledgeIds"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 16
        },
        "operationIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "required": [
        "targetId",
        "name",
        "regionId",
        "fields",
        "inspections",
        "operationIds"
      ],
      "additionalProperties": false
    },
    "Item": {
      "type": "object",
      "properties": {
        "itemId": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "material",
            "tool"
          ]
        },
        "initialLocation": {
          "$ref": "#/$defs/Location"
        },
        "takeCapability": {
          "oneOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "transferable": {
          "type": "boolean"
        },
        "consumedOnUse": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FactField"
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "itemId",
        "name",
        "kind",
        "initialLocation",
        "takeCapability",
        "transferable",
        "consumedOnUse",
        "fields"
      ],
      "additionalProperties": false
    },
    "Knowledge": {
      "type": "object",
      "properties": {
        "knowledgeId": {
          "$ref": "#/$defs/Id"
        },
        "category": {
          "enum": [
            "WorldFact",
            "Claim",
            "Evidence"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "subjectId": {
          "$ref": "#/$defs/Id"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FactField"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "shareable": {
          "type": "boolean"
        }
      },
      "required": [
        "knowledgeId",
        "category",
        "statement",
        "subjectId",
        "sourceIds",
        "fields",
        "shareable"
      ],
      "additionalProperties": false
    },
    "Operation": {
      "type": "object",
      "properties": {
        "operationId": {
          "$ref": "#/$defs/Id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "repair",
            "permit"
          ]
        },
        "targetId": {
          "$ref": "#/$defs/Id"
        },
        "humanOnly": {
          "const": true
        },
        "requiredCapability": {
          "$ref": "#/$defs/Id"
        },
        "requiredTargetValues": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Scalar"
          },
          "maxProperties": 32
        },
        "requiredItemKinds": {
          "type": "array",
          "items": {
            "enum": [
              "material",
              "tool"
            ]
          },
          "minItems": 0,
          "maxItems": 2,
          "uniqueItems": true
        },
        "consumedItemKinds": {
          "type": "array",
          "items": {
            "enum": [
              "material",
              "tool"
            ]
          },
          "minItems": 0,
          "maxItems": 2,
          "uniqueItems": true
        },
        "effectValues": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Scalar"
          },
          "maxProperties": 32
        },
        "recordMaterialField": {
          "oneOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operationId",
        "label",
        "kind",
        "targetId",
        "humanOnly",
        "requiredCapability",
        "requiredTargetValues",
        "requiredItemKinds",
        "consumedItemKinds",
        "effectValues",
        "recordMaterialField"
      ],
      "additionalProperties": false
    },
    "Npc": {
      "type": "object",
      "properties": {
        "characterId": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "initialRegionId": {
          "$ref": "#/$defs/Id"
        },
        "initialKnowledgeIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "initialBeliefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "beliefId": {
                "$ref": "#/$defs/Id"
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "confidence": {
                "enum": [
                  "uncertain",
                  "likely",
                  "confident"
                ]
              },
              "basedOnKnowledgeIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Id"
                },
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true
              }
            },
            "required": [
              "beliefId",
              "statement",
              "confidence",
              "basedOnKnowledgeIds"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 16
        }
      },
      "required": [
        "characterId",
        "name",
        "initialRegionId",
        "initialKnowledgeIds",
        "initialBeliefs"
      ],
      "additionalProperties": false
    },
    "EndingPolicy": {
      "type": "object",
      "properties": {
        "gateTargetId": {
          "$ref": "#/$defs/Id"
        },
        "exitRegionId": {
          "$ref": "#/$defs/Id"
        },
        "requiredNpcIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "originalMaterialId": {
          "$ref": "#/$defs/Id"
        },
        "spareMaterialId": {
          "$ref": "#/$defs/Id"
        },
        "evidenceGroups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "groupId": {
                "$ref": "#/$defs/Id"
              },
              "knowledgeIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Id"
                },
                "minItems": 2,
                "maxItems": 32,
                "uniqueItems": true
              }
            },
            "required": [
              "groupId",
              "knowledgeIds"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 2
        },
        "codes": {
          "type": "object",
          "properties": {
            "clarified": {
              "$ref": "#/$defs/Id"
            },
            "costly": {
              "$ref": "#/$defs/Id"
            },
            "unresolved": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "clarified",
            "costly",
            "unresolved"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "gateTargetId",
        "exitRegionId",
        "requiredNpcIds",
        "originalMaterialId",
        "spareMaterialId",
        "evidenceGroups",
        "codes"
      ],
      "additionalProperties": false
    },
    "Content": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "contentVersion": {
          "$ref": "#/$defs/Id"
        },
        "reducerVersion": {
          "$ref": "#/$defs/Id"
        },
        "asset_source": {
          "const": "original_team"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "timing": {
          "type": "object",
          "properties": {
            "durationSeconds": {
              "type": "integer",
              "minimum": 900,
              "maximum": 1800
            },
            "gracePeriodSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "decisionTimeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120
            }
          },
          "required": [
            "durationSeconds",
            "gracePeriodSeconds",
            "decisionTimeoutSeconds"
          ],
          "additionalProperties": false
        },
        "humanCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Role"
          },
          "minItems": 5,
          "maxItems": 5
        },
        "partyRoles": {
          "type": "object",
          "properties": {
            "2": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Id"
                },
                "minItems": 1,
                "maxItems": 5,
                "uniqueItems": true
              },
              "minItems": 2,
              "maxItems": 2
            },
            "3": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Id"
                },
                "minItems": 1,
                "maxItems": 5,
                "uniqueItems": true
              },
              "minItems": 3,
              "maxItems": 3
            },
            "4": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Id"
                },
                "minItems": 1,
                "maxItems": 5,
                "uniqueItems": true
              },
              "minItems": 4,
              "maxItems": 4
            },
            "5": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Id"
                },
                "minItems": 1,
                "maxItems": 5,
                "uniqueItems": true
              },
              "minItems": 5,
              "maxItems": 5
            }
          },
          "required": [
            "2",
            "3",
            "4",
            "5"
          ],
          "additionalProperties": false
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Region"
          },
          "minItems": 4,
          "maxItems": 32
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Target"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
          },
          "minItems": 3,
          "maxItems": 256
        },
        "knowledge": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Knowledge"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Operation"
          },
          "minItems": 2,
          "maxItems": 32
        },
        "npcs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Npc"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "endingPolicy": {
          "$ref": "#/$defs/EndingPolicy"
        }
      },
      "required": [
        "schemaVersion",
        "contentVersion",
        "reducerVersion",
        "asset_source",
        "title",
        "timing",
        "humanCapabilities",
        "roles",
        "partyRoles",
        "regions",
        "targets",
        "items",
        "knowledge",
        "operations",
        "npcs",
        "endingPolicy"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/Content"
}
