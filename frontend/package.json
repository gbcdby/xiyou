{
  "name": "xiyou-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-check.mjs",
    "test:browser:spatial-retention": "node tests/spatial-retention-browser.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "socket.io-client": "4.8.4",
    "vue": "3.5.45",
    "vue-router": "5.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  }
}
