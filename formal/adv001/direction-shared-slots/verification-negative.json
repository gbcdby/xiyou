    "negative-session-capacity": {
      "config": "negative-session-capacity.cfg",
      "timeout_seconds": 60,
      "workers": 1,
      "heap_mb": 512,
      "expected_invariants": [
        "TypeOK",
        "SessionMoveCapacity"
      ],
      "expected_properties": [],
      "checks_deadlock": false,
      "deadlock_reason": "有限输入和原请求用尽、外部响应永久延迟均允许停顿；此profile为安全反例或可达性探针，不声明活性。",
      "scope": {
        "parameters": {
          "MaxRequests": 3,
          "MaxTime": 1,
          "MaxInputs": 2,
          "MaxClears": 0,
          "ControllerCount": 2,
          "Fault": "omit-global-guard"
        },
        "kind": "negative_control",
        "expected_outcome": "COUNTEREXAMPLE",
        "expected_violation": "SessionMoveCapacity",
        "description": "漏掉controller canSend与最终send两处同一全局准入；跨绑定第三原身份。",
        "time_unit_ms": 100,
        "receipt_due_ticks": 4,
        "liveness": "NOT_CHECKED",
        "implementation_status": "NOT_ASSESSED",
        "model_core_sha256": "c50dacfdc8233af7506dc59a59413e84adfc44e239b34e480608c76e14c1c53b",
        "scope_limit": "仅该有限profile；见证不是全称活性，负控不是生产缺陷。"
      },
      "assumptions": [
        "仅一个controlEpoch；两个controller是同epoch的不同绑定实例。",
        "同步发送的局部登记、会话guard及原draft追加在首次await前视为一个原子动作。",
        "真实Receipt可先于旧Promise的handler/finally；有效Receipt对同一原身份的既定结果一致。",
        "时钟与deadline任务分开，达到due不强制立刻派发；ACK先与timer先都保留。",
        "每实例token；clear不重置，重绑定新实例沿原构造初始化。"
      ]
    },
